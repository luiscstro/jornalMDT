# Copie este arquivo para .env e preencha. Nunca commite o .env.

# Token do bot do Discord (obrigatório)
TOKEN_DISCORD=

# PostgreSQL da Discloud, usado pela navegação do Novo Mundo (opcional).
# Use a URL do card "Private connection" do banco no painel da Discloud.
# Só funciona dentro da rede privada (VLAN) da Discloud.
# Sem esta variável, a navegação usa o Google Sheets (precisa do credenciais.json).
# Use senha só com letras e números (símbolos quebram a URL).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=
